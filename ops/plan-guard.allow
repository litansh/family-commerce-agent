# Every destroy or forget a Terraform plan may carry, one per line: `destroy <address>` or
# `forget <address>`. ops/plan-guard.mjs fails any plan that deletes or forgets something not
# listed here, and never lets the shared OIDC provider or the state bucket be destroyed.
# A line whose resource is already gone is harmless.
#
# retire(1/4): the OIDC provider is shared with adtech-lab and shamir-finops-hub; the state bucket
# outlives the stack. Both leave the state, neither leaves the account.
forget aws_iam_openid_connect_provider.github
forget aws_s3_bucket.tfstate
forget aws_s3_bucket_versioning.tfstate
forget aws_s3_bucket_public_access_block.tfstate
#
# retire(2/4): the product stack. Not here, on purpose: aws_iam_role.github_terraform and
# aws_iam_role_policy.github_terraform, which the apply runs as (forgotten in 3/4, deleted by hand).
# aws_cognito_identity_provider.google[0] is listed though it never existed (google_client_id was empty).
destroy aws_apigatewayv2_api.main
destroy aws_apigatewayv2_authorizer.cognito
destroy aws_apigatewayv2_integration.api
destroy aws_apigatewayv2_route.all
destroy aws_apigatewayv2_route.preflight
destroy aws_apigatewayv2_stage.default
destroy aws_cloudfront_distribution.web
destroy aws_cloudfront_origin_access_control.web
destroy aws_cloudwatch_event_rule.refresh_nightly
destroy aws_cloudwatch_event_target.refresh_nightly
destroy aws_cloudwatch_log_group.api
destroy aws_cloudwatch_log_group.refresh
destroy aws_cloudwatch_log_metric_filter.store_http_errors
destroy aws_cloudwatch_log_metric_filter.store_load_errors
destroy aws_cloudwatch_metric_alarm.store_errors
destroy aws_cloudwatch_metric_alarm.store_load_errors
destroy aws_cognito_identity_provider.google[0]
destroy aws_cognito_user_pool.main
destroy aws_cognito_user_pool_client.mobile
destroy aws_cognito_user_pool_domain.main
destroy aws_dynamodb_table.main
destroy aws_iam_access_key.worker
destroy aws_iam_role.alerts
destroy aws_iam_role.api
destroy aws_iam_role.github_deploy
destroy aws_iam_role.github_review
destroy aws_iam_role.refresh
destroy aws_iam_role_policy.alerts
destroy aws_iam_role_policy.api
destroy aws_iam_role_policy.api_branches
destroy aws_iam_role_policy.api_orders
destroy aws_iam_role_policy.github_deploy
destroy aws_iam_role_policy.github_review
destroy aws_iam_role_policy.refresh
destroy aws_iam_user.worker
destroy aws_iam_user_policy.worker
destroy aws_lambda_function.alerts
destroy aws_lambda_function.api
destroy aws_lambda_function.refresh
destroy aws_lambda_permission.alerts_sns
destroy aws_lambda_permission.apigw
destroy aws_lambda_permission.refresh_nightly
destroy aws_s3_bucket.branch_prices
destroy aws_s3_bucket.web
destroy aws_s3_bucket_lifecycle_configuration.branch_prices
destroy aws_s3_bucket_policy.web
destroy aws_s3_bucket_public_access_block.branch_prices
destroy aws_s3_bucket_public_access_block.web
destroy aws_sns_topic.alerts
destroy aws_sns_topic_subscription.alerts_email
destroy aws_sns_topic_subscription.alerts_telegram
destroy aws_sqs_queue.orders
destroy aws_ssm_parameter.anthropic_key
destroy random_bytes.session_key
destroy random_id.domain
